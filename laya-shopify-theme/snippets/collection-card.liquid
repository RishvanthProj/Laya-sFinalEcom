{% liquid
  assign collection_object = card_collection
  assign title_text = manual_title
  assign link_url = manual_url | default: '#'
  assign badge_label = manual_badge
  assign image_object = manual_image
  assign asset_name = fallback_asset
  assign background_color = manual_background | default: '#E8C8B8'
  assign background_gradient = manual_gradient

  if collection_object != blank
    assign title_text = collection_object.title
    assign link_url = collection_object.url
    if collection_object.featured_image != blank
      assign image_object = collection_object.featured_image
    endif
  endif
%}

<a href="{{ link_url }}" class="group relative block aspect-[5/3] overflow-hidden rounded-sm sm:aspect-[3/4]" aria-label="Shop {{ title_text }}" {% if block %}{{ block.shopify_attributes }}{% endif %}>
  {% if image_object != blank %}
    {{ image_object | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105', loading: 'lazy', alt: title_text }}
  {% elsif asset_name != blank %}
    <img src="{{ asset_name | asset_url }}" alt="{{ title_text | escape }}" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" width="600" height="800">
  {% else %}
    <div class="absolute inset-0 transition-transform duration-700 group-hover:scale-105" style="{% if background_gradient != blank %}background: {{ background_gradient }};{% else %}background: {{ background_color }};{% endif %}"></div>
  {% endif %}
  <div class="absolute inset-0 bg-foreground/25 group-hover:bg-foreground/38 transition-colors"></div>
  <div class="absolute inset-x-0 bottom-0 p-4">
    {% if badge_label != blank %}
      <span class="mb-1 block text-[10px] font-semibold uppercase tracking-[0.18em] text-[#FFD600]">{{ badge_label }}</span>
    {% endif %}
    <span class="text-[11px] uppercase tracking-[0.13em] leading-tight text-white md:text-[12px] md:tracking-[0.18em]">{{ title_text }}</span>
  </div>
</a>
