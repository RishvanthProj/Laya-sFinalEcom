<details class="laya-details border-b border-border/60">
  <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-4 px-4 py-3 text-[13px] uppercase tracking-[0.1em] text-foreground/80">
    <span>Stationery</span>
    {% render 'icon', name: 'chevron-down', class: 'laya-summary-icon h-4 w-4 transition-transform' %}
  </summary>
  <div class="pb-2">
    <details class="laya-details border-t border-border/40 px-4">
      <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-4 py-3 pl-2 text-[12px] uppercase tracking-[0.1em] text-foreground/70">
        <span>Writing Supplies</span>
        {% render 'icon', name: 'chevron-down', class: 'laya-summary-icon h-4 w-4 transition-transform' %}
      </summary>
      <div class="pb-2 pl-6">
        <a href="{{ routes.search_url }}?q=pens&type=product" class="block min-h-10 py-2 text-[12px] uppercase tracking-[0.1em] text-foreground/60">Pens</a>
        <a href="{{ routes.search_url }}?q=pencils&type=product" class="block min-h-10 py-2 text-[12px] uppercase tracking-[0.1em] text-foreground/60">Pencils</a>
        <a href="{{ routes.search_url }}?q=highlighters&type=product" class="block min-h-10 py-2 text-[12px] uppercase tracking-[0.1em] text-foreground/60">Highlighters</a>
      </div>
    </details>
    <a href="{{ routes.search_url }}?q=erasers%20sharpeners&type=product" class="block min-h-11 py-3 pl-6 pr-4 text-[13px] uppercase tracking-[0.1em] text-foreground/80">Erasers &amp; Sharpeners</a>
    <a href="{{ routes.search_url }}?q=notebooks%20journals&type=product" class="block min-h-11 py-3 pl-6 pr-4 text-[13px] uppercase tracking-[0.1em] text-foreground/80">Notebooks &amp; Journals</a>
