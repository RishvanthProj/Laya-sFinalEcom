{% liquid
  assign main_menu = section.settings.menu.links
  assign logo_style = 'max-width: ' | append: settings.logo_width | append: 'px; height: auto;'
  assign use_default_categories = section.settings.use_default_categories
%}

<header data-theme="home" class="sticky top-0 z-40 bg-background/95 backdrop-blur border-b border-border transition-none">
  <nav role="navigation" aria-label="Main" class="container mx-auto flex h-16 items-center justify-between px-4 lg:px-8">
    <button type="button" aria-label="Open menu" data-open-drawer class="md:hidden -ml-2 flex h-11 w-11 items-center justify-center">
      {% render 'icon', name: 'menu', class: 'h-5 w-5' %}
    </button>

    <a href="{{ routes.root_url }}" class="min-w-0 flex-1 truncate text-center font-serif text-[20px] leading-none tracking-tight text-foreground md:flex-none md:text-left md:text-[26px]">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: settings.logo_width | image_tag: widths: '120, 180, 240, 360', class: 'w-auto', style: logo_style, alt: shop.name }}
      {% else %}
        {{ shop.name | default: "Laya's Little Shop" }}
      {% endif %}
    </a>

    <div class="hidden md:flex md:flex-1 md:items-center md:justify-center md:gap-6 md:px-8">
      {% if use_default_categories %}
        {% render 'fallback-menu-desktop' %}
      {% elsif main_menu != blank and main_menu.size > 0 %}
        {% for link in main_menu %}
          <div class="relative laya-nav-item">
            <a href="{{ link.url }}" class="nav-link flex items-center gap-1 {% if link.current %}text-foreground{% endif %}">
              <span>{{ link.title }}</span>
              {% if link.links != blank %}
                {% render 'icon', name: 'chevron-down', class: 'h-3 w-3 opacity-60' %}
              {% endif %}
            </a>

            {% if link.links != blank %}
              <div class="laya-mega-panel absolute left-1/2 top-full -translate-x-1/2 pt-3 z-50">
                <div class="mega-enter bg-white border border-border shadow-[0_20px_40px_-20px_rgba(0,0,0,0.15)] rounded-sm min-w-[260px] py-3">
                  <ul class="flex flex-col" aria-label="{{ link.title }} submenu">
                    {% for child_link in link.links %}
                      <li class="relative laya-subnav-item">
                        <a href="{{ child_link.url }}" class="flex items-center justify-between gap-6 px-5 py-2 text-[12px] uppercase tracking-[0.12em] text-foreground/80 hover:text-accent hover:bg-secondary/40 transition-colors">
                          <span>{{ child_link.title }}</span>
                          {% if child_link.links != blank %}
                            {% render 'icon', name: 'chevron-right', class: 'h-3 w-3 opacity-60' %}
                          {% endif %}
                        </a>

                        {% if child_link.links != blank %}
                          <div class="laya-subnav-panel absolute left-full top-0 pl-1">
                            <div class="mega-enter bg-white border border-border shadow-[0_20px_40px_-20px_rgba(0,0,0,0.15)] rounded-sm min-w-[220px] py-3">
                              <ul aria-label="{{ child_link.title }} options">
                                {% for grandchild_link in child_link.links %}
                                  <li>
                                    <a href="{{ grandchild_link.url }}" class="block px-5 py-2 text-[12px] uppercase tracking-[0.12em] text-foreground/80 hover:text-accent hover:bg-secondary/40 transition-colors">{{ grandchild_link.title }}</a>
                                  </li>
                                {% endfor %}
                              </ul>
                            </div>
                          </div>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        {% render 'fallback-menu-desktop' %}
      {% endif %}
    </div>

    <div class="flex items-center justify-end gap-1 md:min-w-[132px]">
      {% if section.settings.show_search %}
        <button type="button" aria-label="Open search" data-open-search class="flex h-11 w-11 items-center justify-center hover:text-accent transition-colors">
          {% render 'icon', name: 'search', class: 'h-5 w-5' %}
        </button>
      {% endif %}

      {% if section.settings.show_account %}
        <a href="{{ routes.account_login_url }}" aria-label="Account" class="hidden h-11 w-11 items-center justify-center hover:text-accent transition-colors md:flex">
          {% render 'icon', name: 'user', class: 'h-5 w-5' %}
        </a>
      {% endif %}

      {% if section.settings.show_cart %}
        <a href="{{ routes.cart_url }}" aria-label="Cart" class="relative flex h-11 w-11 items-center justify-center hover:text-accent transition-colors">
          {% render 'icon', name: 'bag', class: 'h-5 w-5' %}
          {% if cart.item_count > 0 %}
            <span class="absolute right-1.5 top-1.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-accent px-1 text-[10px] font-semibold leading-none text-white">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      {% endif %}
    </div>
  </nav>
</header>

<div class="laya-drawer md:hidden" data-mobile-drawer>
  <div class="laya-drawer__overlay" data-close-drawer></div>
  <div class="laya-drawer__panel">
    <div class="flex items-center justify-between border-b border-border px-4 py-4">
      <a href="{{ routes.root_url }}" class="font-serif text-[22px] leading-none text-foreground">{{ shop.name | default: "Laya's Little Shop" }}</a>
      <button type="button" aria-label="Close menu" data-close-drawer class="flex h-11 w-11 items-center justify-center">
        {% render 'icon', name: 'close', class: 'h-5 w-5' %}
      </button>
    </div>

    <div class="px-4 py-3">
      <button type="button" data-open-search class="flex min-h-11 w-full items-center justify-between rounded-sm border border-border bg-white px-4 text-left text-[13px] uppercase tracking-[0.12em] text-foreground/70">
        <span>Search products & collections</span>
        {% render 'icon', name: 'search', class: 'h-4 w-4' %}
      </button>
    </div>

    <div class="border-t border-border/60">
      {% if use_default_categories %}
        {% render 'fallback-menu-mobile' %}
      {% elsif main_menu != blank and main_menu.size > 0 %}
        {% for link in main_menu %}
          {% if link.links != blank %}
            <details class="laya-details border-b border-border/60">
              <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-4 px-4 py-3 text-[13px] uppercase tracking-[0.1em] text-foreground/80">
                <span>{{ link.title }}</span>
                {% render 'icon', name: 'chevron-down', class: 'laya-summary-icon h-4 w-4 transition-transform' %}
              </summary>
              <div class="pb-2">
                {% for child_link in link.links %}
                  {% if child_link.links != blank %}
                    <details class="laya-details border-t border-border/40 px-4">
                      <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-4 py-3 pl-2 text-[12px] uppercase tracking-[0.1em] text-foreground/70">
                        <span>{{ child_link.title }}</span>
                        {% render 'icon', name: 'chevron-down', class: 'laya-summary-icon h-4 w-4 transition-transform' %}
                      </summary>
                      <div class="pb-2 pl-6">
                        {% for grandchild_link in child_link.links %}
                          <a href="{{ grandchild_link.url }}" class="block min-h-10 py-2 text-[12px] uppercase tracking-[0.1em] text-foreground/60">{{ grandchild_link.title }}</a>
                        {% endfor %}
                      </div>
                    </details>
                  {% else %}
                    <a href="{{ child_link.url }}" class="block min-h-11 py-3 pl-6 pr-4 text-[13px] uppercase tracking-[0.1em] text-foreground/80">{{ child_link.title }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            </details>
          {% else %}
            <a href="{{ link.url }}" class="block min-h-11 border-b border-border/60 px-4 py-3 text-[13px] uppercase tracking-[0.1em] text-foreground/80">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        {% render 'fallback-menu-mobile' %}
      {% endif %}
    </div>

    <div class="grid grid-cols-2 gap-3 px-4 py-5">
      {% if section.settings.show_account %}
        <a href="{{ routes.account_login_url }}" class="inline-flex min-h-11 items-center justify-center rounded-sm border border-border bg-white px-4 text-[12px] uppercase tracking-[0.12em] text-foreground">Account</a>
      {% endif %}
      {% if section.settings.show_cart %}
        <a href="{{ routes.cart_url }}" class="inline-flex min-h-11 items-center justify-center rounded-sm bg-[#2C2C2A] px-4 text-[12px] uppercase tracking-[0.12em] text-white">Cart ({{ cart.item_count }})</a>
      {% endif %}
    </div>
  </div>
</div>

<div class="laya-search-panel" data-search-panel>
  <div class="laya-search-panel__overlay" data-close-search></div>
  <div class="laya-search-panel__content">
    <div class="flex items-center justify-between border-b border-border px-5 py-4 md:px-6">
      <div>
        <p class="eyebrow mb-1">Search</p>
        <p class="font-serif text-2xl text-foreground">Find products, collections & pages</p>
      </div>
      <button type="button" aria-label="Close search" data-close-search class="flex h-11 w-11 items-center justify-center text-foreground/70 hover:text-accent transition-colors">
        {% render 'icon', name: 'close', class: 'h-5 w-5' %}
      </button>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="px-5 py-5 md:px-6 md:py-6">
      <input type="hidden" name="options[prefix]" value="last">
      <input type="hidden" name="type" value="product,collection,page,article">
      <label class="sr-only" for="Search-In-Overlay">Search</label>
      <div class="flex flex-col gap-3 md:flex-row">
        <input id="Search-In-Overlay" class="laya-search-input flex-1 text-base" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search for journals, jewellery, resin art...">
        <button class="laya-primary-button text-[12px] font-semibold uppercase tracking-[0.14em]" type="submit">Search</button>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">Tip: connect menu items to your Shopify collections for the cleanest navigation experience.</p>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_default_categories",
      "label": "Use built-in category menu",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Turn this off to use the selected Shopify navigation menu instead."
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    }
  ]
}
{% endschema %}
