<section class="w-full overflow-hidden bg-background" aria-label="Featured collections" data-hero-slider data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
  <div class="relative h-[230px] overflow-hidden sm:h-[340px] md:h-[460px] lg:h-[520px]">
    <div class="flex h-full transition-transform duration-700 ease-out" data-hero-track>
      {% for block in section.blocks %}
        {% liquid
          assign slide_image = block.settings.image
          assign fallback_asset = block.settings.fallback_asset
        %}
        <article class="relative h-full w-full shrink-0 overflow-hidden" style="background: {{ block.settings.mobile_background }};" data-hero-slide {{ block.shopify_attributes }}>
          {% if slide_image != blank %}
            {{ slide_image | image_url: width: 2400 | image_tag: widths: '640, 960, 1200, 1600, 2200', class: 'h-full w-full object-contain md:object-cover', loading: 'lazy', alt: block.settings.alt_text | default: block.settings.heading }}
          {% elsif fallback_asset != blank %}
            <img src="{{ fallback_asset | asset_url }}" alt="{{ block.settings.alt_text | escape }}" class="h-full w-full object-contain md:object-cover" loading="lazy" width="1713" height="624">
          {% else %}
            <div class="h-full w-full bg-secondary"></div>
          {% endif %}

          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 px-4 py-4 sm:px-8 sm:py-6 md:px-12">
            <a href="{{ block.settings.link | default: routes.collections_url }}" aria-label="{{ block.settings.button_label | default: 'Shop now' }}" class="laya-hero-button inline-flex min-h-10 items-center justify-center rounded-sm px-5 text-[11px] font-bold uppercase tracking-[0.14em] shadow-[0_12px_28px_rgba(0,0,0,0.18)] transition-colors sm:min-h-11 sm:px-7 sm:text-[12px] sm:tracking-[0.18em]" style="--laya-button-bg: {{ block.settings.button_background }}; --laya-button-text: {{ block.settings.button_text_color }}; --laya-button-hover-bg: {{ block.settings.button_hover_background }}; --laya-button-hover-text: {{ block.settings.button_hover_text_color }};">
              {{ block.settings.button_label }}
            </a>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="absolute bottom-4 right-4 flex gap-2 sm:bottom-5 sm:right-5" aria-label="Carousel slide indicators">
        {% for block in section.blocks %}
          <button type="button" aria-label="Show {{ block.settings.heading }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-slider-dot data-index="{{ forloop.index0 }}" class="h-2.5 rounded-full transition-all {% if forloop.first %}w-8 bg-white{% else %}w-2.5 bg-white/55 hover:bg-white{% endif %}"></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Featured collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Fallback theme image",
          "default": "hero-clearance-sale.png",
          "options": [
            { "value": "hero-clearance-sale.png", "label": "Clearance sale" },
            { "value": "hero-resin-art.png", "label": "Resin art" },
            { "value": "hero-school-supplies.png", "label": "School essentials" },
            { "value": "hero-gold-plated-jewellery.webp", "label": "Gold-plated jewellery" }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Featured collection banner"
        },
        {
          "type": "color",
          "id": "mobile_background",
          "label": "Mobile background",
          "default": "#D1AE18"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Button background",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "button_hover_background",
          "label": "Button hover background",
          "default": "#C1602B"
        },
        {
          "type": "color",
          "id": "button_hover_text_color",
          "label": "Button hover text color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
