<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#c1602b">
    <link rel="canonical" href="{{ canonical_url }}">

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <title>
      {{ page_title }}
      {% if current_tags %} - tagged {{ current_tags | join: ', ' }}{% endif %}
      {% if current_page != 1 %} - Page {{ current_page }}{% endif %}
      {% unless page_title contains shop.name %} - {{ shop.name }}{% endunless %}
    </title>

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {% else %}
      <link rel="icon" href="{{ 'favicon.ico' | asset_url }}">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap">

    {{ content_for_header }}
    {{ 'laya-theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body data-theme="home">
    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
